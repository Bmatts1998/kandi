# Copy to .env for local overrides. Do not commit real secrets.
PORT=8787
HOST=0.0.0.0

# Change this before any public deploy. Render can also generate it.
KANDI_SECRET=change-me-before-launch

# Leave unset to use the local SQLite file at data/kandi.sqlite.
# For Render, set this to a Neon Postgres connection string (direct URI, sslmode=require).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set to 0 to skip auto-seeding an empty database on boot.
SEED_ON_BOOT=1

# Optional. Render / HTTPS proxies set X-Forwarded-Proto; this forces Secure cookies.
# KANDI_SECURE_COOKIE=1
