# Copy to .env for local overrides. Do not commit real secrets.
PORT=8787
HOST=0.0.0.0

# Change this before any public deploy. Render can also generate it.
KANDI_SECRET=change-me-before-launch

# Leave unset to use the local SQLite file at data/kandi.sqlite.
# For Render, set this to a Neon Postgres connection string (direct URI, sslmode=require).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set to 0 to skip auto-seeding an empty database on boot.
SEED_ON_BOOT=1

# Optional. Render / HTTPS proxies set X-Forwarded-Proto; this forces Secure cookies.
# KANDI_SECURE_COOKIE=1

# Optional public origin used for Stripe Checkout and Customer Portal return URLs.
# KANDI_PUBLIC_URL=https://kandi-6rih.onrender.com

# Stripe (website payments only). Leave unset to keep Kandi+ hidden/disabled.
# Never commit real keys. In the iOS app, Stripe is never shown.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# JSON or comma-separated price ids. Monthly and yearly Kandi+ (vip_* optional).
# STRIPE_PRICE_IDS={"plus_monthly":"price_...","plus_3mo":"price_...","plus_6mo":"price_...","plus_yearly":"price_...","founding_monthly":"price_..."}
# Optional test override for founding member cap (default 3000).
# KANDI_FOUNDING_CAP=3000

# Email (sign-up confirmation + password reset). Email is always collected at sign-up.
# Confirmation is only REQUIRED once one provider below is configured; until then
# nobody is locked out. Render Free blocks SMTP ports, so these all use HTTPS APIs.
# EMAIL_FROM="Kandi <hello@yourdomain.com>"   # required for Resend/Postmark
# RESEND_API_KEY=re_...                      # simplest; needs a verified domain to send to anyone
# POSTMARK_SERVER_TOKEN=...
# Gmail API (sends as the Gmail account itself, e.g. kandi.dating@gmail.com):
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...                    # OAuth refresh token with the gmail.send scope
# EMAIL_PROVIDER=resend|postmark|gmail|console|none   # optional override
# EMAIL_VERIFICATION=off                     # collect email but never require confirmation
